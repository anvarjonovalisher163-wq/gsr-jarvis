# ==============================================================
# GSR Jarvis — environment configuration
# Copy this file to the repo root as `.env` and fill in values:
#     cp .env.example .env
# ==============================================================

# --- Claude API (required) ------------------------------------
# Get a key at https://platform.claude.com/
ANTHROPIC_API_KEY=sk-ant-...

# Model used for all tasks. Override here to upgrade later
# (e.g. claude-opus-4-8 for higher quality at higher cost).
CLAUDE_MODEL=claude-sonnet-4-6

# Max output tokens per chat reply (cost control).
CLAUDE_MAX_TOKENS=2048
# Max output tokens for the weekly content plan generation.
CLAUDE_PLAN_MAX_TOKENS=8000
# How many past chat messages are sent to Claude on each turn (cost control).
CHAT_HISTORY_WINDOW=20

# --- Owner authentication (required) --------------------------
OWNER_LOGIN=owner
# bcrypt hash of the owner's password.
# Generate:  python backend/scripts/hash_password.py
OWNER_PASSWORD_HASH=
# Long random string used to sign JWT tokens.
# Generate:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Token lifetime in minutes (43200 = 30 days).
JWT_EXPIRES_MINUTES=43200

# --- Meta / Instagram publishing (optional, needed to publish) -
# Long-lived Page access token with instagram_content_publish permission
# (Meta Business Suite -> developers.facebook.com app -> Instagram Graph API).
META_ACCESS_TOKEN=
# Instagram BUSINESS account ID (numeric, not the username).
IG_BUSINESS_ID=
META_GRAPH_VERSION=v21.0
# Ad account for spend/ROI sync. Needs the ads_read permission on the token.
# Find it in Meta Ads Manager (looks like 1234567890, with or without act_).
META_AD_ACCOUNT_ID=

# --- Web Push notifications (optional) ------------------------
# Generate both keys:  python backend/scripts/generate_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address embedded in push requests.
VAPID_SUBJECT=mailto:you@example.com

# --- CRM webhook (Module 1: data layer) -----------------------
# Shared secret the CRM sends in the X-CRM-Secret header. The same value
# must be set on the CRM side. Empty = webhook endpoint is closed.
# Generate:  python -c "import secrets; print(secrets.token_hex(32))"
CRM_WEBHOOK_SECRET=
# A lead with no CRM activity for this many days is reported as "sovigan".
STALE_LEAD_DAYS=14

# --- Competitor intelligence ----------------------------------
# Scheduled scraping is OFF by default. Set to true to enable the
# daily scrape + weekly analysis jobs. Manual runs from the app
# work regardless of this flag.
COMPETITOR_SCRAPE_ENABLED=false

# --- Image generation (pluggable) -----------------------------
# "stub" disables generation. "openai" uses OpenAI's image API (gpt-image-1,
# ~$0.02-$0.19/image depending on IMAGE_QUALITY) — a plain API key, no
# OAuth, no enterprise contract. (Canva was considered and ruled out: its
# Connect API requires a Canva Enterprise plan for private/internal use —
# confirmed in Canva's own docs.)
IMAGE_PROVIDER=stub
IMAGE_PROVIDER_API_KEY=
IMAGE_QUALITY=medium
# Public origin Instagram fetches generated images from — required for
# IMAGE_PROVIDER=openai. Prod: https://jarvis.gsr.uz — Instagram can never
# reach a local/LAN address, so this only matters for real publishing.
PUBLIC_BASE_URL=

# --- Misc -----------------------------------------------------
TIMEZONE=Asia/Tashkent
# SQLite by default. Upgrade path to Postgres (see README):
#   DATABASE_URL=postgresql+psycopg://jarvis:password@localhost/jarvis
DATABASE_URL=sqlite:///./jarvis.db
# Comma-separated allowed origins. In production behind nginx the
# frontend and API share one origin, so this mostly matters in dev.
CORS_ORIGINS=*

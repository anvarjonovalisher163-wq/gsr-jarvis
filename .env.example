# Nusxa oling: cp .env.example .env   (Windows: copy .env.example .env)
# .env git'ga kirmaydi.

# Supabase (litsenziya serveri). supabase/README.md ga qarang.
MAIN_VITE_SUPABASE_URL=
MAIN_VITE_SUPABASE_ANON_KEY=
# node scripts/gen-license-keys.mjs chiqargan OCHIQ kalit (base64 SPKI). Maxfiy kalit bu yerga qo'yilmaydi!
MAIN_VITE_LICENSE_PUBLIC_KEY=

# Bo'sh qoldirilsa ilova "server sozlanmagan" rejimida: mahalliy 7 kunlik trial limitlari bilan ishlaydi.

# --- Egasi rejimi (ilovani faqat o'zingiz ishlatsangiz) ---
# 1 bo'lsa: litsenziya serveri kerak emas, limitlar yo'q, trial/kalit oynasi chiqmaydi.
# Yuqoridagi Supabase qiymatlari bo'sh qolishi mumkin.
MAIN_VITE_OWNER_MODE=1
# Ixtiyoriy: faqat shu qurilmada cheksiz bo'lsin (Sozlamalar → Litsenziya → Qurilma ID, to'liq 64 belgi)
MAIN_VITE_OWNER_DEVICE_ID=

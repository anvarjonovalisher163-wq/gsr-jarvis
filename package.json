{
  "name": "tg-manager",
  "version": "0.1.2",
  "description": "TG Manager — Telegram boshqaruv paneli (desktop)",
  "main": "./out/main/index.js",
  "author": "GSR",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "postinstall": "electron-rebuild -f -o better-sqlite3",
    "check-env": "node scripts/check-env.mjs",
    "build:mac": "npm run check-env -- --warn && npm run build && node scripts/pack.mjs --mac",
    "build:win": "npm run check-env -- --warn && npm run build && node scripts/pack.mjs --win",
    "build:linux": "npm run check-env -- --warn && npm run build && node scripts/pack.mjs --linux",
    "release": "npm run check-env && npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "adm-zip": "^0.5.18",
    "better-sqlite3": "^12.11.1",
    "big-integer": "^1.6.52",
    "electron-updater": "^6.8.11",
    "grammy": "^1.46.0",
    "node-machine-id": "^1.1.12",
    "react-virtuoso": "^4.18.20",
    "telegram": "^2.26.22",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.17.0",
    "@typescript-eslint/parser": "^8.17.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "lucide-react": "^0.468.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.15.4",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "zustand": "^5.0.2"
  }
}
